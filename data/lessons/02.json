  "texts": [
    {
      "id": "2-1",
      "title": "Bài khoá 1",
      "audio": "2-1",
      "context": "Vương Nhất Phi đang làm quen với học sinh ở trong lớp học.",
      "note": "“请问” là một kính ngữ, được sử dụng khi đề nghị ai đó trả lời câu hỏi.",
      "lines": [
        {
          "s": "yf",
          "zh": "请问，你叫什么名字？",
          "pinyin": "Qǐngwèn, nǐ jiào shénme míngzi?",
          "vi": "Xin hỏi, em tên là gì?"
        },
        {
          "s": "tz",
          "zh": "我叫陈天中。",
          "pinyin": "Wǒ jiào Chén Tiānzhōng.",
          "vi": "Em tên là Trần Thiên Trung ạ."
        }
      ]
    },
    {
      "id": "2-3",
      "title": "Bài khoá 2",
      "audio": "2-3",
      "context": "Trần Thiên Trung đã nhầm Bạch Gia Nguyệt với người khác khi chào hỏi cô ấy ở trong khuôn viên trường.",
      "note": "Trong văn nói, mọi người cũng dùng “没事” hoặc “没事没事” thay cho “没关系”.",
      "lines": [
        {
          "s": "tz",
          "zh": "你好，安妮！",
          "pinyin": "Nǐ hǎo, Ānnī!",
          "vi": "Chào Annie!"
        },
        {
          "s": "jy",
          "zh": "你好，陈天中！我不是安妮，我是白家月。",
          "pinyin": "Nǐ hǎo, Chén Tiānzhōng! Wǒ bú shì Ānnī, wǒ shì Bái Jiāyuè.",
          "vi": "Chào Trần Thiên Trung! Mình không phải là Annie, mình là Bạch Gia Nguyệt."
        },
        {
          "s": "tz",
          "zh": "对不起！",
          "pinyin": "Duìbuqǐ!",
          "vi": "Xin lỗi bạn!"
        },
        {
          "s": "jy",
          "zh": "没关系！",
          "pinyin": "Méi guānxi!",
          "vi": "Không sao đâu!"
        }
      ]
    },
    {
      "id": "2-5",
      "title": "Bài khoá 3",
      "audio": "2-5",
      "context": "Lý Văn và Bạch Gia Nguyệt lần đầu gặp nhau trong khuôn viên trường.",
      "note": "Họ tên của người Trung Quốc gồm: họ + tên (姓 + 名). Ví dụ: 李 (họ) + 文 (tên).",
      "lines": [
        {
          "s": "lw",
          "zh": "你好！我叫李文。",
          "pinyin": "Nǐ hǎo! Wǒ jiào Lǐ Wén.",
          "vi": "Chào bạn! Mình tên là Lý Văn."
        },
        {
          "s": "jy",
          "zh": "你好！我叫白家月。",
          "pinyin": "Nǐ hǎo! Wǒ jiào Bái Jiāyuè.",
          "vi": "Xin chào! Mình tên là Bạch Gia Nguyệt."
        },
        {
          "s": "lw",
          "zh": "很高兴认识你。",
          "pinyin": "Hěn gāoxìng rènshi nǐ.",
          "vi": "Rất vui được làm quen với bạn."
        },
        {
          "s": "jy",
          "zh": "认识你我也很高兴。",
          "pinyin": "Rènshi nǐ wǒ yě hěn gāoxìng.",
          "vi": "Mình cũng rất vui được làm quen với bạn."
        }
      ]
    }
  ],
  "rhyme": {
    "audio": "2-7",
    "lines": [
      {
        "zh": "七加一，再减一，",
        "pinyin": "Qī jiā yī, zài jiǎn yī,",
        "vi": "Bảy cộng một, lại trừ một."
      },
      {
        "zh": "加完减完等于几？",
        "pinyin": "jiāwán jiǎnwán děngyú jǐ?",
        "vi": "Cộng xong trừ xong thì bằng mấy?"
      },
      {
        "zh": "加完减完还是七。",
        "pinyin": "Jiāwán jiǎnwán háishi qī.",
        "vi": "Cộng xong trừ xong vẫn là bảy."
      }
    ]
  },
  "grammar": [
    {
      "id": "2-g1",
      "zh": "汉语的基本语序",
      "vi": "Trật tự từ cơ bản của câu trong tiếng Trung Quốc",
      "explain": "Trật tự từ cơ bản của câu trong tiếng Trung Quốc là: Chủ ngữ + Vị ngữ + Tân ngữ. Ví dụ: 我 (chủ ngữ) 叫 (vị ngữ) 陈天中 (tân ngữ).",
      "pattern": "Chủ ngữ + Vị ngữ + Tân ngữ",
      "examples": [
        {
          "zh": "你叫什么名字？",
          "pinyin": "Nǐ jiào shénme míngzi?",
          "vi": "Bạn tên là gì?"
        },
        {
          "zh": "我叫白家月。",
          "pinyin": "Wǒ jiào Bái Jiāyuè.",
          "vi": "Mình tên là Bạch Gia Nguyệt."
        },
        {
          "zh": "我是学生。",
          "pinyin": "Wǒ shì xuéshēng.",
          "vi": "Mình là học sinh."
        }
      ]
    }
  ],
