  "texts": [
    {
      "id": "3-1",
      "title": "Bài khoá 1",
      "audio": "3-1",
      "context": "Lý Văn và Bạch Gia Nguyệt gặp nhau lần đầu, hai người tiếp tục trò chuyện trong khuôn viên trường.",
      "lines": [
        {
          "s": "lw",
          "zh": "我是中国人。",
          "pinyin": "Wǒ shì Zhōngguó rén.",
          "vi": "Mình là người Trung Quốc."
        },
        {
          "s": "jy",
          "zh": "我是法国人。我的中文老师也是中国人。",
          "pinyin": "Wǒ shì Fǎguó rén. Wǒ de Zhōngwén lǎoshī yě shì Zhōngguó rén.",
          "vi": "Mình là người Pháp. Giáo viên tiếng Trung Quốc của mình cũng là người Trung Quốc."
        }
      ]
    },
    {
      "id": "3-3",
      "title": "Bài khoá 2",
      "audio": "3-3",
      "context": "Sau giờ học, Annie đang xem ảnh trên điện thoại di động của Trần Thiên Trung ở trong lớp học.",
      "note": "Từ “谁” cũng có thể đọc là “shuí”.",
      "lines": [
        {
          "s": "an",
          "zh": "这是谁？",
          "pinyin": "Zhè shì shéi?",
          "vi": "Đây là ai vậy?"
        },
        {
          "s": "tz",
          "zh": "这是我女朋友。",
          "pinyin": "Zhè shì wǒ nǚpéngyou.",
          "vi": "Đây là bạn gái mình."
        },
        {
          "s": "an",
          "zh": "你女朋友是哪国人？",
          "pinyin": "Nǐ nǚpéngyou shì nǎ guó rén?",
          "vi": "Bạn gái của bạn là người nước nào?"
        },
        {
          "s": "tz",
          "zh": "她也是泰国人。",
          "pinyin": "Tā yě shì Tàiguó rén.",
          "vi": "Cô ấy cũng là người Thái Lan."
        }
      ]
    },
    {
      "id": "3-5",
      "title": "Bài khoá 3",
      "audio": "3-5",
      "context": "Vương Nhất Tuyết đang gọi video cho Vương Nhất Phi ở trong nhà.",
      "lines": [
        {
          "s": "yx",
          "zh": "喂，一飞！",
          "pinyin": "Wèi, Yīfēi!",
          "vi": "A lô, Nhất Phi à!"
        },
        {
          "s": "yf",
          "zh": "姐姐！",
          "pinyin": "Jiějie!",
          "vi": "Vâng, chị!"
        },
        {
          "s": "yx",
          "zh": "你工作还忙吗？",
          "pinyin": "Nǐ gōngzuò hái máng ma?",
          "vi": "Công việc của em vẫn bận lắm à?"
        },
        {
          "s": "yf",
          "zh": "对，还很忙。你也很忙吗？",
          "pinyin": "Duì, hái hěn máng. Nǐ yě hěn máng ma?",
          "vi": "Vâng, vẫn rất bận. Chị cũng bận lắm phải không?"
        },
        {
          "s": "yx",
          "zh": "我不太忙。我们很想你。",
          "pinyin": "Wǒ bú tài máng. Wǒmen hěn xiǎng nǐ.",
          "vi": "Chị không bận lắm. Mọi người đều rất nhớ em."
        },
        {
          "s": "yf",
          "zh": "我也想你们。",
          "pinyin": "Wǒ yě xiǎng nǐmen.",
          "vi": "Em cũng nhớ mọi người."
        }
      ]
    }
  ],
  "grammar": [
    {
      "id": "3-g1",
      "zh": "“是”字句",
      "vi": "Câu chữ “是”",
      "explain": "Câu chữ “是” được dùng để định danh người hoặc sự vật, hình thức phủ định là “不是”.",
      "pattern": "A + 是 + B · A + 不是 + B",
      "examples": [
        {
          "zh": "我是法国人。",
          "pinyin": "Wǒ shì Fǎguó rén.",
          "vi": "Mình là người Pháp."
        },
        {
          "zh": "她是中文老师。",
          "pinyin": "Tā shì Zhōngwén lǎoshī.",
          "vi": "Cô ấy là giáo viên tiếng Trung."
        },
        {
          "zh": "我老师不是法国人。",
          "pinyin": "Wǒ lǎoshī bú shì Fǎguó rén.",
          "vi": "Giáo viên của mình không phải người Pháp."
        }
      ]
    },
    {
      "id": "3-g2",
      "zh": "结构助词“的”",
      "vi": "Trợ từ kết cấu “的”",
      "explain": "Trợ từ kết cấu “的” được đặt giữa định ngữ và trung tâm ngữ để diễn đạt mối quan hệ sở hữu. Trong trường hợp trước “的” là đại từ nhân xưng, sau “的” là từ chỉ quan hệ thân thuộc hoặc danh từ chỉ người, “的” có thể được lược bỏ.",
      "pattern": "Định ngữ + 的 + Danh từ",
      "examples": [
        {
          "zh": "白家月的中文老师",
          "pinyin": "Bái Jiāyuè de Zhōngwén lǎoshī",
          "vi": "giáo viên tiếng Trung của Bạch Gia Nguyệt"
        },
        {
          "zh": "你的名字",
          "pinyin": "nǐ de míngzi",
          "vi": "tên của bạn"
        },
        {
          "zh": "我老师",
          "pinyin": "wǒ lǎoshī",
          "vi": "giáo viên của tôi (lược bỏ 的)"
        },
        {
          "zh": "我妈妈",
          "pinyin": "wǒ māma",
          "vi": "mẹ của tôi (lược bỏ 的)"
        }
      ]
    },
    {
      "id": "3-g3",
      "zh": "用“吗”的是非问句",
      "vi": "Câu hỏi “có… (hay) không?” sử dụng từ “吗”",
      "explain": "“吗” là trợ từ ngữ khí, thường được đặt ở cuối câu để tạo thành câu hỏi “có… (hay) không?”.",
      "pattern": "Câu trần thuật + 吗？",
      "examples": [
        {
          "zh": "你也很忙吗？",
          "pinyin": "Nǐ yě hěn máng ma?",
          "vi": "Bạn cũng rất bận à?"
        },
        {
          "zh": "你是他的中文老师吗？",
          "pinyin": "Nǐ shì tā de Zhōngwén lǎoshī ma?",
          "vi": "Bạn là giáo viên tiếng Trung của anh ấy phải không?"
        },
        {
          "zh": "你有姐姐吗？",
          "pinyin": "Nǐ yǒu jiějie ma?",
          "vi": "Bạn có chị gái không?"
        }
      ]
    }
  ],
