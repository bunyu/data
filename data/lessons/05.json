  "texts": [
    {
      "id": "5-1", "title": "Bài khoá 1", "audio": "5-1",
      "context": "Lưu Minh và Vương Nhất Tuyết đang trò chuyện ở trong nhà.",
      "note": "Ngày 8 tháng 9 cũng có thể được diễn đạt là “9月8日”. Chủ nhật cũng có thể nói là “星期天”.",
      "lines": [
        { "s": "yx", "zh": "今天几号？", "pinyin": "Jīntiān jǐ hào?", "vi": "Hôm nay ngày mấy anh nhỉ?" },
        { "s": "lm", "zh": "今天9月8号。", "pinyin": "Jīntiān jiǔ yuè bā hào.", "vi": "Hôm nay là ngày 8 tháng 9." },
        { "s": "yx", "zh": "星期几？", "pinyin": "Xīngqī jǐ?", "vi": "Thứ mấy vậy?" },
        { "s": "lm", "zh": "星期日。今天我休息。", "pinyin": "Xīngqīrì. Jīntiān wǒ xiūxi.", "vi": "Chủ nhật. Hôm nay anh được nghỉ." }
      ]
    },
    {
      "id": "5-3", "title": "Bài khoá 2", "audio": "5-3",
      "context": "Vương Nhất Tuyết và Dương Đồng Lạc đang trò chuyện trong giờ nghỉ tại công ty.",
      "lines": [
        { "s": "yx", "zh": "你会做饭吗？", "pinyin": "Nǐ huì zuò fàn ma?", "vi": "Em có biết nấu ăn không?" },
        { "s": "tl", "zh": "我会做。", "pinyin": "Wǒ huì zuò.", "vi": "Em biết." },
        { "s": "yx", "zh": "你会做什么？", "pinyin": "Nǐ huì zuò shénme?", "vi": "Em biết nấu món gì?" },
        { "s": "tl", "zh": "我会做面条儿、饺子，也会做一些菜。星期天我也做饭。", "pinyin": "Wǒ huì zuò miàntiáor, jiǎozi, yě huì zuò yìxiē cài. Xīngqītiān wǒ yě zuò fàn.", "vi": "Em biết nấu mì, sủi cảo và biết chế biến một số món ăn khác. Chủ nhật em cũng nấu ăn." }
      ]
    },
    {
      "id": "5-5", "title": "Bài khoá 3", "audio": "5-5",
      "context": "Vương Nhất Tuyết và Dương Đồng Lạc đang trò chuyện sau giờ làm ở công ty.",
      "lines": [
        { "s": "yx", "zh": "同乐，下班吗？", "pinyin": "Tónglè, xiàbān ma?", "vi": "Đồng Lạc, em tan làm chưa?" },
        { "s": "tl", "zh": "下班。", "pinyin": "Xiàbān.", "vi": "Em tan làm rồi." },
        { "s": "yx", "zh": "这是你的新电脑吗？", "pinyin": "Zhè shì nǐ de xīn diànnǎo ma?", "vi": "Đây là máy tính mới của em à?" },
        { "s": "tl", "zh": "是的，是我的新电脑。", "pinyin": "Shì de, shì wǒ de xīn diànnǎo.", "vi": "Đúng vậy, đây là máy tính mới của em." },
        { "s": "yx", "zh": "真好看！", "pinyin": "Zhēn hǎokàn!", "vi": "Đẹp thật đấy!" },
        { "s": "tl", "zh": "我也很喜欢它。", "pinyin": "Wǒ yě hěn xǐhuan tā.", "vi": "Em cũng rất thích nó." }
      ]
    }
  ],
  "grammar": [
    {
      "id": "5-g1", "zh": "时间的表达（1）", "vi": "Cách diễn đạt thời gian (1)",
      "explain": "Trật tự diễn đạt ngày tháng và thứ trong tuần trong tiếng Trung Quốc là: năm → tháng → ngày → thứ (年→月→日/号→星期). Tháng: 一月 … 十二月. Thứ: 星期一 (thứ Hai) … 星期六 (thứ Bảy), 星期日/星期天 (Chủ nhật).",
      "pattern": "……年……月……日/号，星期……",
      "examples": [
        { "zh": "1992年5月16日/号，星期六", "pinyin": "yī jiǔ jiǔ èr nián wǔ yuè shíliù rì/hào, Xīngqīliù", "vi": "Thứ Bảy, ngày 16 tháng 5 năm 1992" },
        { "zh": "今天9月8号。", "pinyin": "Jīntiān jiǔ yuè bā hào.", "vi": "Hôm nay là ngày 8 tháng 9." },
        { "zh": "明天是2024年8月18号，星期天。", "pinyin": "Míngtiān shì èr líng èr sì nián bā yuè shíbā hào, Xīngqītiān.", "vi": "Ngày mai là Chủ nhật, ngày 18 tháng 8 năm 2024." }
      ]
    },
    {
      "id": "5-g2", "zh": "名词谓语句", "vi": "Câu vị ngữ danh từ",
      "explain": "Trong câu vị ngữ danh từ, thành phần vị ngữ chỉ có danh từ hoặc thành phần có tính chất như một danh từ; thường là những từ ngữ chỉ thời gian, ngày tháng, tuổi tác… (không cần “是”).",
      "pattern": "Chủ ngữ + Danh từ (thời gian, ngày tháng, tuổi)",
      "examples": [
        { "zh": "今天几号？", "pinyin": "Jīntiān jǐ hào?", "vi": "Hôm nay ngày mấy?" },
        { "zh": "今天5月1号。", "pinyin": "Jīntiān wǔ yuè yī hào.", "vi": "Hôm nay ngày 1 tháng 5." },
        { "zh": "我妹妹12岁。", "pinyin": "Wǒ mèimei shí'èr suì.", "vi": "Em gái tôi 12 tuổi." }
      ]
    },
    {
      "id": "5-g3", "zh": "能愿动词“会”", "vi": "Động từ năng nguyện “会”",
      "explain": "“会” đặt trước động từ, biểu thị việc biết hoặc có khả năng thực hiện một hành động nào đó thông qua học tập. Phủ định: 不会.",
      "pattern": "Chủ ngữ + (不)会 + Động từ",
      "examples": [
        { "zh": "你会做饭吗？", "pinyin": "Nǐ huì zuò fàn ma?", "vi": "Bạn có biết nấu ăn không?" },
        { "zh": "我会做面条儿。", "pinyin": "Wǒ huì zuò miàntiáor.", "vi": "Tôi biết nấu mì." },
        { "zh": "我不会做菜。", "pinyin": "Wǒ bú huì zuò cài.", "vi": "Tôi không biết nấu món ăn." }
      ]
    }
  ],
