  "texts": [
    {
      "id": "1-1",
      "title": "Bài khoá 1",
      "audio": "1-1",
      "context": "Ngày đầu tiên đi học, Vương Nhất Phi chào hỏi trợ giảng AI Tiểu Ngữ ở trong văn phòng.",
      "lines": [
        {
          "s": "yf",
          "zh": "AI小语，你好！",
          "pinyin": "AI Xiǎoyǔ, nǐ hǎo!",
          "vi": "Xin chào AI Tiểu Ngữ!"
        },
        {
          "s": "xy",
          "zh": "王老师，你好！",
          "pinyin": "Wáng lǎoshī, nǐ hǎo!",
          "vi": "Chào cô Vương!"
        }
      ]
    },
    {
      "id": "1-3",
      "title": "Bài khoá 2",
      "audio": "1-3",
      "context": "Ngày đầu tiên đi học, các bạn học sinh học cách diễn đạt chào hỏi tại lớp.",
      "note": "“您” là đại từ nhân xưng mang sắc thái trang trọng, được dùng để xưng hô với người lớn tuổi hoặc những người mà bạn kính trọng.",
      "lines": [
        {
          "s": "yf",
          "zh": "大家好！",
          "pinyin": "Dàjiā hǎo!",
          "vi": "Chào cả lớp!"
        },
        {
          "s": "xs",
          "zh": "老师，您好！",
          "pinyin": "Lǎoshī, nín hǎo!",
          "vi": "Chào cô ạ!"
        },
        {
          "s": "xy",
          "zh": "你们好！",
          "pinyin": "Nǐmen hǎo!",
          "vi": "Chào các bạn!"
        },
        {
          "s": "xs",
          "zh": "你好，小语！",
          "pinyin": "Nǐ hǎo, Xiǎoyǔ!",
          "vi": "Chào Tiểu Ngữ!"
        }
      ]
    },
    {
      "id": "1-5",
      "title": "Bài khoá 3",
      "audio": "1-5",
      "context": "Ngày đầu tiên đi học, các bạn học sinh học các mẫu câu cảm ơn và tạm biệt ở trong lớp học.",
      "lines": [
        {
          "s": "xs",
          "zh": "谢谢！",
          "pinyin": "Xièxie!",
          "vi": "Cảm ơn bạn!"
        },
        {
          "s": "xy",
          "zh": "不客气！",
          "pinyin": "Bú kèqi!",
          "vi": "Đừng khách sáo!"
        },
        {
          "s": "yf",
          "zh": "同学们，再见！",
          "pinyin": "Tóngxuémen, zàijiàn!",
          "vi": "Tạm biệt các em!"
        },
        {
          "s": "xs",
          "zh": "老师，再见！",
          "pinyin": "Lǎoshī, zàijiàn!",
          "vi": "Tạm biệt cô ạ!"
        }
      ]
    }
  ],
  "rhyme": {
