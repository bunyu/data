        "zh": "妈种麻，我放马。",
        "pinyin": "Mā zhòng má, wǒ fàng mǎ.",
        "vi": "Mẹ trồng cây gai, tôi thả ngựa."
      },
      {
        "zh": "马吃麻，妈骂马。",
        "pinyin": "Mǎ chī má, mā mà mǎ.",
        "vi": "Ngựa ăn cây gai, mẹ mắng ngựa."
      }
    ]
  },
  "grammar": [
    {
      "id": "1-g1",
      "zh": "您 和 你",
      "vi": "Cách dùng “您” (trang trọng) và “你”",
      "note": "Bổ sung để ôn tập, dựa trên phần “Tiểu Ngữ giúp sức” của bài 1.",
      "explain": "“你” dùng với bạn bè, người ngang hàng. “您” là cách xưng hô kính trọng, dùng với người lớn tuổi, thầy cô hoặc người mình kính trọng. Thêm “们” sau “你” để chỉ số nhiều: 你们.",
      "pattern": "老师，您好！ · 你们好！",
      "examples": [
        {
          "zh": "老师，您好！",
          "pinyin": "Lǎoshī, nín hǎo!",
          "vi": "Chào cô ạ!"
        },
        {
          "zh": "你们好！",
          "pinyin": "Nǐmen hǎo!",
          "vi": "Chào các bạn!"
        },
        {
          "zh": "同学们，再见！",
          "pinyin": "Tóngxuémen, zàijiàn!",
          "vi": "Tạm biệt các em!"
        }
      ]
    }
  ],
